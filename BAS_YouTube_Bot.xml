     <Script><![CDATA[RS("threads", false, false)!
RESOURCE_1 = _result().get()

section(RESOURCE_1 /*{{threads}}*/, 100000 /*100000*/, 100000 /*100000*/, 0, function(){

   section_start("Siapkan Jaringan & Buka Browser", 1000)!
   /*Dat:eyJ1dG8iOiIwIiwiZiI6W10sInVtIjoiMCIsInV0IjoiMCIsInMiOiJjdXN0b20iLCJ2IjoxLCJkIjpbeyJjbGFzcyI6InN0cmluZyIsImRhdGEiOiJTaWFwa2FuIEphcmluZ2FuICYgQnVrYSBCcm93c2VyIiwiaWQiOiJDb2RlIiwidHlwZSI6ImNvbnN0ciJ9XSwidXciOiIwIn0=*/
   if (typeof P_THREAD_CYCLE === "undefined") {
      P_THREAD_CYCLE = 0;
   } else {
      P_THREAD_CYCLE++;
   }
   var tNum = parseInt(thread_number()) || 1;

   // 1. Baca listnegara.txt untuk info lokasi
   var cFile = "C:/Users/Admin/Documents/PROJWK NEW/listnegara.txt";
   var cRaw = "";
   try { cRaw = native("filesystem", "readfile", JSON.stringify({value: cFile, base64: false, from: 0, to: 0})); } catch(e) {}
   var cList = cRaw.split(/\r?\n/).map(function(l) { return l.trim(); }).filter(function(l) { return l.length > 0; });
   if (cList.length === 0) {
      cList = ["United States", "United Kingdom", "Germany", "Singapore", "Japan", "Netherlands", "Canada"];
   }
   VAR_COUNTRY = cList[Math.floor(Math.random() * cList.length)];

   // 2. Baca urls.txt & pilih video bergantian untuk setiap thread
   var uFile = "C:/Users/Admin/Documents/PROJWK NEW/urls.txt";
   var uRaw = "";
   try { uRaw = native("filesystem", "readfile", JSON.stringify({value: uFile, base64: false, from: 0, to: 0})); } catch(e) {}
   var listUrls = uRaw.split(/\r?\n/).map(function(l) { return l.trim(); }).filter(function(l) { return l.length > 10 && l.indexOf("http") >= 0; });
   if (listUrls.length === 0) {
      listUrls = ["https://www.youtube.com/watch?v=dQw4w9WgXcQ", "https://www.youtube.com/watch?v=jNQXAC9IVRw"];
   }
   var videoIdx = (tNum - 1 + P_THREAD_CYCLE) % listUrls.length;
   VAR_CURRENT_URL = listUrls[videoIdx];
   VAR_VIDEO_NUM = videoIdx + 1;
   VAR_TOTAL_VIDEOS = listUrls.length;

   // 3. Durasi tonton & delay
   RS("duration_min", false, false)!
   var minD = parseInt(_result().get()) || 30;
   RS("duration_max", false, false)!
   var maxD = parseInt(_result().get()) || 60;
   if (maxD < minD) { maxD = minD; }
   VAR_TARGET_DUR = Math.floor(Math.random() * (maxD - minD + 1)) + minD;

   RS("delay_between", false, false)!
   VAR_DELAY_SEC = parseInt(_result().get()) || 5;

   // 4. Pengaturan Jaringan & Proxy (CARA B vs CARA A)
   var pFile = "C:/Users/Admin/Documents/PROJWK NEW/proxies.txt";
   var pRaw = "";
   try { pRaw = native("filesystem", "readfile", JSON.stringify({value: pFile, base64: false, from: 0, to: 0})); } catch(e) {}
   var pList = pRaw.split(/\r?\n/).map(function(l) { return l.trim(); }).filter(function(l) { return l.length > 5 && l.indexOf(":") > 0 && l.indexOf("#") !== 0; });

   if (pList.length > 0) {
      var pIdx = (tNum - 1 + P_THREAD_CYCLE) % pList.length;
      var rawProxy = pList[pIdx];
      var pParts = rawProxy.split(":");
      var pHost = pParts[0].trim();
      var pPort = pParts[1].trim();
      var pUser = pParts.length > 2 ? pParts[2].trim() : "";
      var pPass = pParts.length > 3 ? pParts[3].trim() : "";

      set_proxy_prepare("default", "")!
      set_proxy(pHost, pPort, true, pUser, pPass)!
      log_success("[Thread " + tNum + "] [CARA B - PROXY AKTIF] Proxy (" + (pIdx + 1) + "/" + pList.length + "): " + pHost + ":" + pPort);
   } else {
      // PENTING: JANGAN PANGGIL set_proxy JIKA TIDAK ADA PROXY!
      // Browser akan langsung menggunakan koneksi VPN Surfshark Desktop / Sistem.
      log_success("[Thread " + tNum + "] [CARA A - SURFSHARK DESKTOP] Menggunakan koneksi VPN Surfshark Desktop (Lokasi: " + VAR_COUNTRY + ")");
   }

   // 5. User-Agent
   RS("user_agents", false, false)!
   var uaVal = _result().get();
   if (uaVal && uaVal.toString().trim().length > 0) {
      header("User-Agent", uaVal.toString().trim())!
   }

   // 6. WAJIB: Buka Browser Chromium
   browser()!
   log_success("[Thread " + tNum + "] [OK] Browser Chromium Berhasil Terbuka");

   // 7. Muat Mesin Otomasi yt_engine.js ke Browser
   var engineFile = "C:/Users/Admin/Documents/PROJWK NEW/yt_engine.js";
   VAR_ENGINE_CODE = "";
   try { VAR_ENGINE_CODE = native("filesystem", "readfile", JSON.stringify({value: engineFile, base64: false, from: 0, to: 0})); } catch(e) {}
   if (VAR_ENGINE_CODE && VAR_ENGINE_CODE.toString().length > 50) {
      onloadjavascript(VAR_ENGINE_CODE.toString())!
      log_success("[Thread " + tNum + "] [OK] Fitur Auto-Play & Deep Ad-Skipper Berhasil Dipasang");
   }

   log_success("[Thread " + tNum + "] [TARGET] Video " + VAR_VIDEO_NUM + "/" + VAR_TOTAL_VIDEOS + ": " + VAR_CURRENT_URL + " (Target Durasi: " + VAR_TARGET_DUR + " detik)");
   section_end()!

   section_start("Buka Video YouTube (Load URL)", 1001)!
   /*Dat:eyJ1dG8iOiIwIiwiZiI6W10sInVtIjoiMCIsInV0IjoiMCIsInMiOiJjdXN0b20iLCJ2IjoxLCJkIjpbeyJjbGFzcyI6InN0cmluZyIsImRhdGEiOiJCdWthIFZpZGVvIFlvdVR1YmUgKExvYWQgVVJMKSIsImlkIjoiQ29kZSIsInR5cGUiOiJjb25zdHIifV0sInV3IjoiMCJ9*/
   log_success("[Thread " + tNum + "] [START] Membuka URL: " + VAR_CURRENT_URL);
   load(VAR_CURRENT_URL)!
   sleep(3000)!
   log_success("[Thread " + tNum + "] [OK] Halaman YouTube Berhasil Dimuat & Video Berputar");
   section_end()!

   section_start("Menonton Video & Emulasi Pengguna", 1002)!
   /*Dat:eyJ1dG8iOiIwIiwiZiI6W10sInVtIjoiMCIsInV0IjoiMCIsInMiOiJjdXN0b20iLCJ2IjoxLCJkIjpbeyJjbGFzcyI6InN0cmluZyIsImRhdGEiOiJNZW5vbnRvbiBWaWRlbyAmIEVtdWxhc2kgUGVuZ2d1bmEiLCJpZCI6IkNvZGUiLCJ0eXBlIjoiY29uc3RyIn1dLCJ1dyI6IjAifQ==*/
   RS("human_emulation", false, false)!
   var humanOpt = _result().get();

   VAR_ELAPSED = 0;
   while (VAR_ELAPSED < VAR_TARGET_DUR) {
      sleep(5000)!
      VAR_ELAPSED += 5;

      if (humanOpt && humanOpt.toString().indexOf("Aktif") >= 0 && (VAR_ELAPSED % 15 === 0)) {
         var scrollDelta = Math.floor(Math.random() * 200) - 100;
         scroll(0, scrollDelta)!
      }

      if (VAR_ELAPSED % 10 === 0 || VAR_ELAPSED >= VAR_TARGET_DUR) {
         log("[Thread " + tNum + "] Sedang menonton... (" + VAR_ELAPSED + "/" + VAR_TARGET_DUR + " detik)");
      }
   }
   log_success("[Thread " + tNum + "] [DONE] Selesai menonton video (" + VAR_TARGET_DUR + " detik)");
   section_end()!

   section_start("Jeda Antar Video & Rotasi", 1003)!
   /*Dat:eyJ1dG8iOiIwIiwiZiI6W10sInVtIjoiMCIsInV0IjoiMCIsInMiOiJjdXN0b20iLCJ2IjoxLCJkIjpbeyJjbGFzcyI6InN0cmluZyIsImRhdGEiOiJKZWRhIEFudGFyIFZpZGVvICYgUm90YXNpIiwiaWQiOiJDb2RlIiwidHlwZSI6ImNvbnN0ciJ9XSwidXciOiIwIn0=*/
   if (VAR_DELAY_SEC > 0) {
      log("[Thread " + tNum + "] Istirahat " + VAR_DELAY_SEC + " detik sebelum video berikutnya...");
      sleep(VAR_DELAY_SEC * 1000)!
   }
   section_end()!
})!]]></Script>
